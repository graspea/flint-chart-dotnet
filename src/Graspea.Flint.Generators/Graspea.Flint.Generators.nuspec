<?xml version="1.0" encoding="utf-8"?>
<!-- The generator package (design §12.6.1, §12.9 step 1); the tokens come from NuspecProperties in the project file. -->
<package xmlns="http://schemas.microsoft.com/packaging/2013/05/nuspec.xsd">
  <metadata>
    <id>Graspea.Flint.Generators</id>
    <version>$version$</version>
    <title>Flint.NET source generator</title>
    <authors>GRASPEA</authors>
    <owners>GRASPEA</owners>
    <license type="expression">MIT</license>
    <icon>icon.png</icon>
    <readme>README.md</readme>
    <projectUrl>https://github.com/graspea/flint-chart-dotnet</projectUrl>
    <repository type="git" url="https://github.com/graspea/flint-chart-dotnet" />
    <copyright>Copyright (c) 2026 GRASPEA s.r.o.</copyright>
    <description>Unofficial C# source generator for Flint (flint-chart): [FlintChart("Charts/revenue.flint.json")] on a static partial class turns a Flint ChartAssemblyInput JSON file in the project, such as one an AI agent keeps editing with flint-chart-mcp, into a typed chart builder at compile time, and the build reports a spec that does not match the catalog or the bound row type. Reference it at the version of the Graspea.Flint package it requires. It does not render charts. Not affiliated with or endorsed by Microsoft.</description>
    <tags>flint flint-chart chartassemblyinput chart charts visualization dataviz codegen source-generator roslyn csharp json ai agent</tags>
    <dependencies>
      <group targetFramework="net8.0">
        <dependency id="Graspea.Flint" version="[$version$]" />
      </group>
    </dependencies>
  </metadata>
  <files>
    <file src="$output$Graspea.Flint.Generators.dll" target="analyzers/dotnet/roslyn4.14/cs/" />
    <file src="build/Graspea.Flint.Generators.targets" target="build/" />
    <file src="_._" target="lib/net8.0/" />
    <file src="README.md" target="" />
    <file src="$root$icon.png" target="" />
    <file src="$root$THIRD-PARTY-NOTICES.md" target="" />
  </files>
</package>
