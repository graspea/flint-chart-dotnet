<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework />
    <TargetFrameworks>net10.0;net8.0</TargetFrameworks>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <LangVersion>13</LangVersion>
    <!-- The compile probes reference Roslyn; the tests are not an analyzer. -->
    <EnforceExtendedAnalyzerRules>false</EnforceExtendedAnalyzerRules>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="NUnit" />
    <PackageReference Include="NUnit3TestAdapter" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="NUnit.Framework" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/Graspea.Flint/Graspea.Flint.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The discriminated union converter logic, tested over test-only unions: no generated union exists on every pin. -->
    <Compile Include="../../src/Graspea.Flint/Model/Json/Converters/DiscriminatedUnion.cs" LinkBase="Linked" />
    <!-- The type resolution and the temporal conversion the validator ports, checked against the probe record
         (Parity/ChannelTypesTests.cs, TemporalConversionTests.cs): no public member returns a resolved type. -->
    <Compile Include="../../src/Graspea.Flint/Validation/Rules/FieldTypes.cs;../../src/Graspea.Flint/Validation/Rules/TemporalParse.cs;../../src/Graspea.Flint/Validation/Rules/Js.cs" LinkBase="Linked" />
    <Compile Include="../../src/Graspea.Flint/Model/CatalogTables.cs;../../src/Graspea.Flint/Generated/Tables/CatalogTables.g.cs" LinkBase="Linked" />
    <!-- Where the accepts predicates apply (ChartValidatorTests.Accepts.cs): no catalog row of a pin lacks the label for a
         key that has a predicate, so a row without one is built in the test. -->
    <Compile Include="../../src/Graspea.Flint/Validation/Rules/Accepts.cs" LinkBase="Linked" />
  </ItemGroup>

</Project>
